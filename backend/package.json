{
  "name": "harvik-sales-backend",
  "version": "1.0.0",
  "description": "Harvik Technologies Sales Dashboard Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seed.js",
    "seed:users": "node scripts/seedUsers.js",
    "clear:data": "node scripts/clearDummyData.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "test:unit": "node --test test/*Validators*.test.js test/calculations.test.js test/targetCalculations.test.js",
    "test:integration": "node --test --test-concurrency=1 test/*Integration*.test.js test/dashboardOverview.test.js test/e2eScenarios.test.js",
    "test:api": "node --test test/gatewayConnectivity.test.js test/auth.test.js",
    "test:security": "node --test test/security.test.js",
    "test:concurrency": "node --test test/concurrency.test.js",
    "test:reconciliation": "node --test test/dashboardOverview.test.js",
    "test:harness": "node --test --test-concurrency=1 test/**/*.test.js"


  },
  "keywords": [],
  "author": "Harvik Technologies",
  "license": "ISC",
  "devDependencies": {
    "bullmq": "^6.3.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "morgan": "^1.12.1",
    "redis": "^6.3.0",
    "uuid": "^14.0.2"
  }
}
